{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/web run build",
  "outputDirectory": "artifacts/web/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vercel-website-fixer--lekom60588.replit.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}